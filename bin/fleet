#!/usr/bin/env bash
# fleet — dispatch and supervise parallel AI coding agents via herdr.
set -euo pipefail

usage() {
  cat <<'USAGE'
fleet — parallel agent dispatch over herdr

  fleet run <repo> <branch> <prompt> [-k claude|cursor] [-d <dir>]...
      Create a git worktree for <branch> off <repo>, start an agent in it,
      and submit <prompt>. Does not steal focus. Prints the agent name.
      -m/--mode sets the agent permission mode (auto, acceptEdits, plan, ...)
      for unattended runs; defaults to $FLEET_PERMISSION_MODE.
      -d/--add-dir grants the agent tool access to another directory
      (repeatable) — use it when the task spans repos that share a contract.
      Note this is full access, not read-only: the agent can edit there too.

  fleet batch <file>
      Dispatch every line of a plan file. Format, one task per line:
          <repo> | <branch> | <prompt>
      Blank lines and lines starting with # are ignored.

  fleet status
      One line per agent: name/pane, kind, state, cwd.

  fleet watch
      status, refreshed every 5s until you Ctrl-C.

  fleet wait <name> [<name>...]
      Block until each agent is idle/done/blocked.

  fleet read <name> [lines]
      Print an agent's recent terminal output (default 120 lines).

  fleet ready
      List only agents that are idle/blocked — i.e. waiting on you.

  fleet babysit [--topic <t>] [--interval <s>] [--grace <s>] [--keep] [--test]
      Keep the Mac awake, watch EVERY dispatched agent across all projects, and
      push a phone notification when one blocks or when all of them settle.
      One instance covers everything; you do not run it per project.
      --keep stays up after settling so you can dispatch more during the day.

  fleet space <path> [--agent claude|cursor|none] [--label name]
      Create a workspace with the standard layout: tab 1 agent + app + shell,
      tab 2 nvim, tab 3 lazygit. Commands are pre-typed, not auto-run.

  fleet preview <path> [--dry-run]
      Start that repo/worktree's dev server on a free, deterministic port and
      print the localhost URL. Also: --list, --logs <name>, --stop <name>, --stop-all.

  fleet trees [--all|--prune|--rm <branch>]
      List TASK worktrees (the ones agents create) with dirty/ahead/merged
      state and any agent attached. Every repo's own folder is also a worktree,
      so --all includes those. --prune clears stale registrations.
      --rm <branch> closes its workspace and removes the checkout.

Examples:
  fleet run ~/src/api PROJ-42 "/ship fix the timezone rollover"
  fleet run ~/src/web PROJ-43 "/ship add the export button" -k cursor
  fleet ready
  fleet read PROJ-42
USAGE
}

# Locate the python formatter: alongside the script (repo layout), then libexec.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
for c in "$SELF_DIR/fleet-fmt.py" "$SELF_DIR/../libexec/fleet-fmt.py" "$HOME/.local/libexec/fleet-fmt.py"; do
  [ -f "$c" ] && { FMT="$c"; break; }
done
: "${FMT:?fleet-fmt.py not found next to fleet or in ~/.local/libexec}"
for c in "$SELF_DIR/fleet-trees.py" "$SELF_DIR/../libexec/fleet-trees.py" "$HOME/.local/libexec/fleet-trees.py"; do
  [ -f "$c" ] && { TREES="$c"; break; }
done
for mod in fleet-preview.sh fleet-space.sh fleet-babysit.sh; do
  for c in "$SELF_DIR/$mod" "$SELF_DIR/../libexec/$mod" "$HOME/.local/libexec/$mod"; do
    [ -f "$c" ] && { . "$c"; break; }
  done
done

# Roots searched by `fleet trees`. Override with FLEET_ROOTS (colon-separated),
# or set it in ~/.config/fleet/config.
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/fleet/config" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/fleet/config"
FLEET_ROOTS="${FLEET_ROOTS:-$HOME/dev}"

need() { command -v "$1" >/dev/null 2>&1 || { echo "fleet: missing dependency '$1'" >&2; exit 127; }; }
need git; need python3; need herdr

jq_py() { python3 -c "import sys,json;$1" ; }

# Default agent kind for a path, from FLEET_AGENT_DEFAULTS ("prefix=kind:prefix=kind").
# Longest matching prefix wins; falls back to $FLEET_AGENT, then claude.
_default_kind() {
  local path="$1" best="" bestlen=0 entry prefix kind
  local IFS_SAVE="$IFS"; IFS=':'
  local entries=(${FLEET_AGENT_DEFAULTS:-}); IFS="$IFS_SAVE"
  for entry in ${entries+"${entries[@]}"}; do
    prefix="${entry%%=*}"; kind="${entry#*=}"
    prefix="${prefix/#\~/$HOME}"
    case "$path" in
      "$prefix"*) [ "${#prefix}" -gt "$bestlen" ] && { best="$kind"; bestlen="${#prefix}"; } ;;
    esac
  done
  printf '%s' "${best:-${FLEET_AGENT:-claude}}"
}


_agent_field() { # name, field -> value
  herdr agent list 2>/dev/null | python3 -c "
import sys,json
try: a=json.load(sys.stdin)['result']['agents']
except Exception: sys.exit()
print(next((str(x.get('$2','')) for x in a if (x.get('name') or x['pane_id'])=='$1'), ''))"
}

_submit_prompt() { # name, prompt -> 0 submitted, 1 not
  local name="$1" text="$2" seq0 i
  seq0=$(_agent_field "$name" state_change_seq)

  herdr agent prompt "$name" "$text" >/dev/null 2>&1 || true

  # Some agent TUIs accept the typed text but drop the submit keypress, leaving
  # it in the input box. Detect "nothing happened" and press Enter once.
  for i in 1 2 3 4 5 6; do
    case "$(_agent_field "$name" agent_status)" in
      working|done) return 0 ;;
    esac
    [ "$(_agent_field "$name" state_change_seq)" != "$seq0" ] && return 0
    [ "$i" = 2 ] && herdr agent send-keys "$name" Enter >/dev/null 2>&1
    sleep 2
  done
  return 1
}

cmd_run() {
  local repo="" branch="" prompt="" kind="" pmode="${FLEET_PERMISSION_MODE:-}"
  local -a extra_dirs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -k|--kind) kind="$2"; shift 2 ;;
      -d|--add-dir) extra_dirs+=("${2/#\~/$HOME}"); shift 2 ;;
      -m|--mode) pmode="$2"; shift 2 ;;
      *) if   [ -z "$repo" ];   then repo="$1"
         elif [ -z "$branch" ]; then branch="$1"
         else prompt="${prompt:+$prompt }$1"; fi; shift ;;
    esac
  done
  [ -n "$repo" ] && [ -n "$branch" ] && [ -n "$prompt" ] || { usage; exit 1; }
  case "$kind" in claude|cursor|codex|gemini|copilot|opencode|amp|droid) ;;
    *) echo "fleet: unsupported --kind '$kind'" >&2; exit 1 ;; esac
  repo="${repo/#\~/$HOME}"
  [ -n "$kind" ] || kind=$(_default_kind "$(cd "$repo" 2>/dev/null && pwd || echo "$repo")")
  [ -d "$repo/.git" ] || { echo "not a git repo: $repo" >&2; exit 1; }

  local created pane
  created=$(herdr worktree create --cwd "$repo" --branch "$branch" --no-focus --json)
  pane=$(printf '%s' "$created" | jq_py "print(json.load(sys.stdin)['result']['root_pane']['pane_id'])")

  local ws
  ws=$(printf '%s' "$created" | jq_py "print(json.load(sys.stdin)['result']['workspace']['workspace_id'])")

  # The worktree's shell may not have reached its prompt yet; agent start
  # fails with agent_pane_busy if we race it.
  local try
  for try in 1 2 3 4 5 6 7 8; do
    case "$(herdr pane process-info --pane "$pane" 2>/dev/null)" in
      *'"agent"'*|*shell*|*zsh*|*bash*) break ;;
    esac
    sleep 1
  done

  local -a agent_args=()
  local ed
  for ed in ${extra_dirs+"${extra_dirs[@]}"}; do
    [ -d "$ed" ] || { echo "fleet: --add-dir path not found: $ed" >&2; herdr workspace close "$ws" >/dev/null 2>&1; return 1; }
    agent_args+=(--add-dir "$ed")
  done
  [ -n "$pmode" ] && agent_args+=(--permission-mode "$pmode")
  local started=0 attempt
  for attempt in 1 2 3; do
    if herdr agent start "$branch" --kind "$kind" --pane "$pane" --timeout 90000 \
         ${agent_args+-- "${agent_args[@]}"} >/dev/null 2>&1; then
      started=1; break
    fi
    sleep 3
  done
  if [ "$started" -eq 0 ]; then
    echo "fleet: '$kind' failed to start in $pane; removing the worktree just created" >&2
    local wtpath
    wtpath=$(printf '%s' "$created" | jq_py "print(json.load(sys.stdin)['result']['worktree']['path'])" 2>/dev/null || true)
    herdr workspace close "$ws" >/dev/null 2>&1 || true
    if [ -n "$wtpath" ] && [ -d "$wtpath" ]; then
      git -C "$repo" worktree remove --force "$wtpath" >/dev/null 2>&1 || rm -rf "$wtpath"
      git -C "$repo" worktree prune >/dev/null 2>&1 || true
    fi
    return 1
  fi
  sleep 2   # let the agent TUI finish painting before typing into it
  if ! _submit_prompt "$branch" "$prompt"; then
    echo "fleet: agent '$branch' started but did not begin working." >&2
    echo "       The prompt may be sitting unsubmitted in its input box." >&2
    echo "       Check with: fleet read $branch" >&2
    return 1
  fi
  echo "$branch  ($kind in $pane)${extra_dirs+ +$((${#extra_dirs[@]})) extra dir(s)}"
}

cmd_trees() {
  local arg="${1:-}" target="${2:-}"
  case "$arg" in
    --prune)
      local IFS_SAVE="$IFS"; IFS=':'; local roots=($FLEET_ROOTS); IFS="$IFS_SAVE"
      for root in "${roots[@]}"; do
        for d in "$root"/*/; do
          [ -d "${d%/}/.git" ] || continue
          git -C "${d%/}" worktree prune 2>/dev/null
        done
      done
      echo "pruned stale registrations"
      FLEET_ROOTS="$FLEET_ROOTS" python3 "$TREES"
      return 0 ;;
    --rm)
      [ -n "$target" ] || { echo "usage: fleet trees --rm <branch>" >&2; return 1; }
      cmd_trees_rm "$target"; return $? ;;
    --all|--linked|"") FLEET_ROOTS="$FLEET_ROOTS" python3 "$TREES" $arg; return 0 ;;
    *) echo "usage: fleet trees [--linked|--prune|--rm <branch>]" >&2; return 1 ;;
  esac
}

cmd_trees_rm() {
  local branch="$1" IFS_SAVE="$IFS"
  IFS=':'; local roots=($FLEET_ROOTS); IFS="$IFS_SAVE"
  local found=""
  for root in "${roots[@]}"; do
    for d in "$root"/*/; do
      local r="${d%/}"
      [ -d "$r/.git" ] || continue
      local p
      p=$(git -C "$r" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
        /^worktree /{path=$2} $0=="branch "b{print path}')
      [ -n "$p" ] && { found="$p"; break 2; }
    done
  done
  [ -n "$found" ] || { echo "fleet: no worktree on branch '$branch'" >&2; return 1; }

  if [ -n "$(git -C "$found" status --porcelain 2>/dev/null)" ]; then
    echo "fleet: '$branch' has uncommitted changes at $found" >&2
    echo "       commit or discard them first, or use: git worktree remove --force \"$found\"" >&2
    return 1
  fi
  local ws
  ws=$(herdr workspace list 2>/dev/null | python3 -c "
import sys,json
try: ws=json.load(sys.stdin)['result']['workspaces']
except Exception: ws=[]
print(next((w['workspace_id'] for w in ws if w.get('worktree',{}).get('checkout_path')=='$found'), ''))" 2>/dev/null)
  [ -n "$ws" ] && { herdr workspace close "$ws" >/dev/null 2>&1; echo "  closed workspace $ws"; }
  git -C "$found" worktree remove "$found" 2>/dev/null || git worktree remove "$found" 2>/dev/null
  echo "removed worktree $found"
  echo "  branch '$branch' still exists — delete with: git -C <repo> branch -d $branch"
}

cmd_status() {
  herdr agent list | python3 "$FMT" status
}

cmd_ready() {
  herdr agent list | python3 "$FMT" ready
}

cmd_batch() {
  local file="${1:?usage: fleet batch <file>}"
  [ -f "$file" ] || { echo "no such file: $file" >&2; exit 1; }
  local n=0
  while IFS='|' read -r repo branch prompt; do
    repo="$(echo "${repo:-}" | xargs)"; branch="$(echo "${branch:-}" | xargs)"
    prompt="$(echo "${prompt:-}" | sed -e 's/^ *//' -e 's/ *$//')"
    case "$repo" in ''|\#*) continue ;; esac
    [ -n "$branch" ] && [ -n "$prompt" ] || { echo "skipping malformed line: $repo" >&2; continue; }
    cmd_run "$repo" "$branch" "$prompt"
    n=$((n+1))
  done < "$file"
  echo "dispatched $n task(s)"
}

cmd_dash() {
  printf '\n\033[1mAGENTS\033[0m\n'
  cmd_status | sed 's/^/  /'
  printf '\n\033[1mPREVIEWS\033[0m\n'
  cmd_preview --list
  printf '\n\033[1mTASK WORKTREES\033[0m\n'
  FLEET_ROOTS="$FLEET_ROOTS" python3 "$TREES" | sed 's/^/  /'
  printf '\n\033[2m  fleet run <repo> <branch> "<prompt>"   dispatch      fleet ready    what needs you\n'
  printf '  fleet space <path>                     open a project      fleet help     everything else\033[0m\n\n'
}

case "${1:-}" in
  run)    shift; cmd_run "$@" ;;
  batch)  shift; cmd_batch "$@" ;;
  status) cmd_status ;;
  ready)  cmd_ready ;;
  trees)  shift; cmd_trees "$@" ;;
  preview) shift; cmd_preview "$@" ;;
  babysit) shift; cmd_babysit "$@" ;;
  space)   shift; cmd_space "$@" ;;
  watch)  while true; do clear; date "+%H:%M:%S"; cmd_status; sleep 5; done ;;
  wait)   shift; for a in "$@"; do echo "waiting: $a"; herdr agent wait "$a" >/dev/null; echo "  done: $a"; done ;;
  read)   shift; herdr agent read "$1" --lines "${2:-120}" --format text ;;
  ""|dash) cmd_dash ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
