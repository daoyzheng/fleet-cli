#!/usr/bin/env bash
# secret-scan — block credentials and flag test scaffolding before they reach a commit/PR.
#   secret-scan            scan staged changes (pre-commit)
#   secret-scan <ref>      scan diff against <ref>, e.g. secret-scan origin/main
#   --strict             treat warnings as blocking - use before a PR
# Exit 1 = blocking finding. Exit 0 = clean (warnings still printed).
set -uo pipefail

STRICT=0
for a in "$@"; do [ "$a" = "--strict" ] && STRICT=1; done
set -- $(for a in "$@"; do [ "$a" = "--strict" ] || printf '%s ' "$a"; done)

case "${1:-}" in
  -h|--help)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

git rev-parse --git-dir >/dev/null 2>&1 || { echo "secret-scan: not inside a git repository" >&2; exit 2; }

BASE="${1:-}"
if [ -n "$BASE" ] && ! git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null; then
  echo "secret-scan: '$BASE' is not a valid git ref" >&2; exit 2
fi
files=$( [ -n "$BASE" ] && git diff --name-only --diff-filter=ACM "$BASE" || git diff --cached --name-only --diff-filter=ACM )
[ -n "$files" ] || exit 0

fail=0
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT

emit() { # severity label file matchline
  local sev="$1"
  [ "$STRICT" = 1 ] && sev="BLOCK"
  if [ "$sev" = "BLOCK" ]; then printf '\n  \033[31mBLOCK\033[0m  %s\n         \033[2m%s\033[0m\n         %s\n' "$2" "$3" "$4"; fail=1
  else printf '\n  \033[33mwarn \033[0m  %s\n         \033[2m%s\033[0m\n         %s\n' "$2" "$3" "$4"; fi
}

scan_file() {
  local f="$1" added sev lbl pat is_test
  [ -n "$BASE" ] && added=$(git diff -U0 "$BASE" -- "$f") || added=$(git diff --cached -U0 -- "$f")
  added=$(printf '%s\n' "$added" | grep -E '^\+' | grep -vE '^\+\+\+')
  [ -n "$added" ] || return 0

  # Vue/JSX attribute bindings and handler references are not secrets
  added=$(printf '%s\n' "$added" \
    | grep -vE '(@|v-|:)[a-zA-Z-]*(password|token|secret)[a-zA-Z-]*="[a-zA-Z_$][A-Za-z0-9_$.]*"' \
    | grep -vE '(password|token|secret)[a-zA-Z]*\s*[:=]\s*["'"'"'](\{\{|\$\{|process\.env|import\.meta|config\.|env\.)')

  case "$f" in
    *test*|*Test*|*spec*|*__tests__*|*mock*|*Mock*|*fake*|*.example|*.md) is_test=1 ;;
    *) is_test=0 ;;
  esac

  # --- hard credentials: blocking everywhere, including tests ---
  while IFS='|' read -r sev lbl pat; do
    [ -n "$sev" ] || continue
    hit=$(printf '%s\n' "$added" | grep -nEi -e "$pat" | head -2 | cut -c1-130)
    [ -n "$hit" ] && emit "$sev" "$lbl" "$f" "$(printf '%s' "$hit" | tr '\n' ' ')"
  done <<'RULES'
BLOCK|Private key material|-----BEGIN [A-Z ]*PRIVATE KEY-----
BLOCK|Azure storage connection string|DefaultEndpointsProtocol=.*AccountKey=
BLOCK|Cloud access key|(AccountKey=[A-Za-z0-9+/]{40,}|AKIA[0-9A-Z]{16})
BLOCK|npm/NuGet registry password|:_(password|authToken)=[A-Za-z0-9+/=]{20,}
BLOCK|Vendor token literal|(ghp_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{32,})
BLOCK|JWT literal|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}
RULES

  # --- assigned secrets: blocking in source, warn in tests/fixtures ---
  local asev="BLOCK"; [ "$is_test" = "1" ] && asev="WARN"
  hit=$(printf '%s\n' "$added" | grep -nEi -e '(password|passwd|secret|api[_-]?key|apikey|client[_-]?secret|access[_-]?token|auth[_-]?token|STRAPI_TOKEN|SAS_TOKEN)["'"'"']?\s*[:=]\s*["'"'"'][^"'"'"'${}<]{8,}' | head -2 | cut -c1-130)
  [ -n "$hit" ] && emit "$asev" "Hardcoded credential assignment" "$f" "$(printf '%s' "$hit" | tr '\n' ' ')"

  # --- test scaffolding: always warn ---
  hit=$(printf '%s\n' "$added" | grep -nE -e '\b(describe|it|test)\.(only|skip)\(' | head -2 | cut -c1-130)
  [ -n "$hit" ] && emit WARN "Focused/skipped test left in" "$f" "$(printf '%s' "$hit" | tr '\n' ' ')"
  hit=$(printf '%s\n' "$added" | grep -nE -e '^\+\s*debugger\s*;?\s*$|tempDisableSecurity\s*[:=]\s*true|skipAuth\s*[:=]\s*true' | head -2 | cut -c1-130)
  [ -n "$hit" ] && emit WARN "Debug/auth bypass left in" "$f" "$(printf '%s' "$hit" | tr '\n' ' ')"
}

for f in $files; do
  case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.svg|*.pdf|*.woff*|*.ico|*lock*|*.snap) continue ;; esac
  scan_file "$f"
done

if [ "$fail" -eq 1 ]; then
  printf '\n\033[31m✗ secret-scan blocked this change.\033[0m\n  Move the value to .env (gitignored) and read it from config.\n  False positive? Commit with --no-verify.\n\n'
  exit 1
fi
printf '\033[32m✓ secret-scan clean%s\033[0m\n' "$([ "$STRICT" = 1 ] && echo ' (strict)')"
exit 0
